# Copy this file to .env and fill in your key.
# Get a free key (no credit card needed) at https://aistudio.google.com/apikey
#
# Privacy note: on the free tier, Google's terms allow prompts/responses to
# be used to improve their products. Only use synthetic/dummy patient data
# during development and demos — never a real patient's information — both
# for this reason and because the consent flow isn't implemented in this
# module.
GEMINI_API_KEY=

# Current free-tier flash model as of Sept 2026. Model IDs change — check
# https://ai.google.dev/gemini-api/docs/models if this stops working.
GEMINI_MODEL=gemini-3.5-flash

# How hard Gemini "thinks" before answering each turn: minimal|low|medium|high.
# Left unset, gemini-3.5-flash defaults to "medium" — measured on legion to
# cost 30-60s+ per turn by mid-interview, which is why app/llm.py now sets
# this explicitly instead of leaving it to the model's default. "low" is a
# deliberate middle ground (this task still makes a red_flag/triage_level
# judgment call, not just pure extraction) — try "minimal" only after
# confirming triage_level/red_flag quality holds up at "low" in practice.
GEMINI_THINKING_LEVEL=low

# Local (Ollama) backend — see README's "Optional: a local model via Ollama"
# section. OLLAMA_MODEL/OLLAMA_URL only need setting if you're not using the
# defaults (gemma4:12b, http://localhost:11434).
# OLLAMA_MODEL=gemma4:12b
# OLLAMA_URL=http://localhost:11434

# Context window Ollama reserves for this model, in tokens. Left unset,
# Ollama guesses based on detected VRAM (as little as 4k under 24 GiB) —
# explicit here because this module's system prompt + a full transcript can
# approach that under AYUSH mode + Hindi + a long interview, and a silently
# truncated system prompt (dropped instructions, no error) is worse than a
# slightly slower response. 8192 is a margin over the worst-case estimate,
# not a benchmarked number — tune down if VRAM is tight.
OLLAMA_NUM_CTX=8192

# How long Ollama keeps this model loaded in memory after each request
# before unloading it. Ollama's own default is "5m" — measured on legion via
# `ollama ps` coming back empty between interviews, meaning the model had
# already unloaded and the next patient's first message would pay a cold
# reload on top of normal inference time. "30m" keeps it warm through a
# normal clinic session; use -1 to never unload at all if this machine is
# dedicated to the kiosk (holds VRAM permanently in exchange for zero reload
# risk — a reasonable trade for a dedicated kiosk box, less obviously right
# on a shared dev machine).
OLLAMA_KEEP_ALIVE=30m

# How often the server pings Ollama in the background to keep it warm (see
# app/main.py's lifespan/_ollama_heartbeat_loop). Keep this comfortably
# below OLLAMA_KEEP_ALIVE's duration — if the heartbeat is slower than the
# model would unload on its own anyway, it isn't actually preventing
# anything. No-op (just a cheap reachability check) if Ollama isn't running.
OLLAMA_HEARTBEAT_MINUTES=20

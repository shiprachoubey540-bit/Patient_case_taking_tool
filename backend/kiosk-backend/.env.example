# This module has no LLM/model of its own — it orchestrates the other
# services, which hold their own GEMINI_API_KEY / WHISPER_MODEL separately.
#
# Only override these if the other services aren't on the default ports
# (e.g. running them on another machine, or you changed --port).
CONVERSE_URL=http://localhost:8000
OCR_URL=http://localhost:8001
VOICE_URL=http://localhost:8003
